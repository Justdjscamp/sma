# Port for Next.js application
PORT=3000
NODE_ENV=production

# Server Public Hostname / Domain for realty-analytics.ru
NEXT_PUBLIC_APP_URL=https://realty-analytics.ru

# Proxy List for Avito / CIAN parsing (Optional, comma-separated proxies)
# Example: http://user:pass@1.2.3.4:8080,http://user:pass@5.6.7.8:8080
PROXY_LIST=

# Yandex Maps Static & Geocoding API Key (Optional)
# Get key at https://developer.tech.yandex.ru/
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=9619c7e5-c893-48c6-bb81-931f92411a40
